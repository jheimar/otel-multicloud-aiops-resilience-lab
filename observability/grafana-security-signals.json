      "id": 1,
      "type": "timeseries",
      "title": "Intentos de autenticación fallida (logs)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"kubernetes-pods\"} |~ \"(?i)(unauthorized|login failed|authentication failed|\\\\b401\\\\b|\\\\b403\\\\b)\" [5m]))",
          "queryType": "range"
        }
      ]
    },
    {
