{
  "uid": "gameday",
  "title": "Game Day - OTEL",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (RPS)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[2m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia de aplicaci\u00f3n p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket[2m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Respuestas 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5xx\"}[2m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disponibilidad de scraping",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(up)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Service B solicitudes/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inventory_requests_total[2m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Collector m\u00e9tricas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_spans[2m]))"
        }
      ]
    }
  ]
}