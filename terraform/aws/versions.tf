terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.50.0"
    }
  }
}

provider "aws" {
  region  = var.aws_region
  profile = var.aws_profile

  default_tags {
    tags = {
      Project     = "otel-multicloud-aiops-resilience-lab"
      Environment = "laboratory"
      ManagedBy   = "Terraform"
    }
  }
}
